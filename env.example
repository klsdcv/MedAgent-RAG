# 로컬에서 사용 시 `cp env.example .env` 후 채워서 사용.
# 실제 시크릿은 절대 커밋 금지.

# ───────── GCP 공통 ─────────
GCP_PROJECT_ID=civic-athlete-500200-t0
GCP_LOCATION=us-central1
GCS_STAGING_BUCKET=gs://civic-athlete-500200-t0-vertex-staging

# ───────── Vertex AI ─────────
VERTEX_MODEL_GEMINI=gemini-2.5-flash
VERTEX_EMBED_MODEL=text-multilingual-embedding-002

# ───────── Vertex AI Search (Discovery Engine) ─────────
SEARCH_DATA_STORE_ID=med-rag-drugs
SEARCH_ENGINE_ID=med-rag-engine
SEARCH_COLLECTION=default_collection

# ───────── Vector Search ─────────
VECTOR_INDEX_ID=
VECTOR_INDEX_ENDPOINT_ID=
VECTOR_DEPLOYED_INDEX_ID=med_rag_v1

# ───────── FDA DUR API ─────────
FDA_DUR_BASE_URL=https://api.fda.gov/drug

# ───────── Agent Engine ─────────
AGENT_ENGINE_RESOURCE_NAME=

# ───────── UI ─────────
UI_BACKEND_URL=
